{
  "name": "@shutro/server",
  "version": "0.0.0",
  "description": "HTTP API for the Shutro web client: sign-in, metadata, records, live events, apps",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@shutro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shutro/core": "workspace:*",
    "@shutro/driver-pg": "workspace:*",
    "@shutro/migrate": "workspace:*",
    "@shutro/sql": "workspace:*"
  },
  "devDependencies": {
    "@shutro/apps": "workspace:*",
    "@shutro/testing": "workspace:*"
  }
}
