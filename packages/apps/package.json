{
  "name": "@shutro/apps",
  "version": "0.0.0",
  "description": "The official Shutro apps: Settings, Accounting, Sales, Purchase and Project",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@shutro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-views.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shutro/core": "workspace:*",
    "@shutro/sql": "workspace:*"
  },
  "devDependencies": {
    "@shutro/cli": "workspace:*",
    "@shutro/driver-pg": "workspace:*",
    "@shutro/migrate": "workspace:*",
    "@shutro/testing": "workspace:*"
  }
}
