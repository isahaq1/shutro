{
  "name": "@shutro/driver-pg",
  "version": "0.0.0",
  "description": "PostgreSQL connection pool, prepared statements, transactions and savepoints",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@shutro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@shutro/sql": "workspace:*",
    "@shutro/testing": "workspace:*",
    "decimal.js": "^10.6.0",
    "fast-check": "^4.10.2"
  }
}
